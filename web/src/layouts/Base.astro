---
import '@fontsource/poppins/latin-400.css';
import '@fontsource/poppins/latin-500.css';
import '@fontsource/jetbrains-mono/latin-400.css';
import '../styles/global.css';
import '../styles/motion.css';
import MotionBoot from '../components/MotionBoot.astro';
import { site } from '../data/site';
interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}
const {
  title = 'FocusPhone — launcher minimalista para Android',
  description = site.description,
  noindex = false
} = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const socialImage = Astro.site ? new URL('/images/social.png', Astro.site).href : '/images/social.png';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <MotionBoot />
    <meta name="theme-color" content="#181818" />
    <meta name="color-scheme" content="dark light" />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/webp" href="/images/focusphone-icon.webp" />
    <link rel="apple-touch-icon" href="/images/focusphone-icon.webp" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="FocusPhone" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="FocusPhone. Menos pantalla, más vida. Launcher minimalista para Android."
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <slot name="head" />
  </head>
  <body>
    <span class="header-sentinel" data-header-sentinel aria-hidden="true"></span>
    <a class="skip-link" href="#contenido">
      saltar al contenido
    </a>
    <slot />
    <noscript>
      <style is:global>
        .header {
          position: static;
        }
        .experience-controls,
        .profile-tabs,
        #breath-start,
        .menu-toggle {
          display: none !important;
        }
        @layer base {
          .profile-panel[hidden] {
            display: block !important;
          }
          @media (max-width: 900px) {
            .mobile-nav[hidden] {
              display: block !important;
              position: static;
            }
          }
        }
        .profile-panel + .profile-panel {
          border-top: 1px solid #555;
        }
        @media (max-width: 900px) {
          .mobile-nav[hidden] {
            display: block !important;
            position: static;
            max-height: none;
            overflow: visible;
          }
        }
      </style>
    </noscript>
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
